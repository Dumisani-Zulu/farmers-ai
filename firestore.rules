// Firestore Security Rules for Farmers AI App
// Copy and paste these rules into your Firebase Console -> Firestore Database -> Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if user owns the document by uid field
    function isDocumentOwner() {
      return request.auth.uid == resource.data.uid;
    }
    
    // Helper function to check if user owns the document by userId field
    function isDocumentOwnerByUserId() {
      return request.auth.uid == resource.data.userId;
    }
    
    // User Profiles Collection
    match /user_profiles/{userId} {
      // Allow users to read and write their own profile
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Allow users to create their own profile
      allow create: if isAuthenticated() && 
                   isOwner(userId) && 
                   request.resource.data.uid == request.auth.uid;
    }
    
    // User Preferences Collection
    match /user_preferences/{userId} {
      // Allow users to read and write their own preferences
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Allow users to create their own preferences
      allow create: if isAuthenticated() && 
                   isOwner(userId) && 
                   request.resource.data.userId == request.auth.uid;
    }
    
    // User Farms Collection
    match /user_farms/{farmId} {
      // Allow users to read and write their own farms
      allow read, write: if isAuthenticated() && 
                        (isDocumentOwnerByUserId() || 
                         request.resource.data.userId == request.auth.uid);
      
      // Allow users to create farms for themselves
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
    }
    
    // User Crops Collection
    match /user_crops/{cropId} {
      // Allow users to read and write their own crops
      allow read, write: if isAuthenticated() && 
                        (isDocumentOwnerByUserId() || 
                         request.resource.data.userId == request.auth.uid);
      
      // Allow users to create crops for themselves
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
    }
    
    // User Activities Collection
    match /user_activities/{activityId} {
      // Allow users to read and write their own activities
      allow read, write: if isAuthenticated() && 
                        (isDocumentOwnerByUserId() || 
                         request.resource.data.userId == request.auth.uid);
      
      // Allow users to create activities for themselves
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
    }
    
    // General Users Collection (if needed for additional data)
    match /users/{userId} {
      // Allow users to read and write their own user document
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Allow users to create their own user document
      allow create: if isAuthenticated() && 
                   isOwner(userId) && 
                   request.resource.data.uid == request.auth.uid;
    }
    
    // Public read access for app metadata (if needed)
    match /app_config/{document} {
      allow read: if true; // Public read access for app configuration
      allow write: if false; // Only admins can write (handle via Admin SDK)
    }
    
    // Community/Forum data
    match /forum_posts/{postId} {
      // Public read access for posts
      allow read: if true;
      
      // Only authenticated users can create posts
      allow create: if isAuthenticated() && 
                   request.resource.data.author.uid == request.auth.uid;
      
      // Only post author can edit their posts
      allow update: if isAuthenticated() && 
                   resource.data.author.uid == request.auth.uid;
      
      // Only post author can delete their posts
      allow delete: if isAuthenticated() && 
                   resource.data.author.uid == request.auth.uid;
    }
    
    match /forum_replies/{replyId} {
      // Public read access for replies
      allow read: if true;
      
      // Only authenticated users can create replies
      allow create: if isAuthenticated() && 
                   request.resource.data.author.uid == request.auth.uid;
      
      // Only reply author can edit their replies
      allow update: if isAuthenticated() && 
                   resource.data.author.uid == request.auth.uid;
      
      // Only reply author can delete their replies
      allow delete: if isAuthenticated() && 
                   resource.data.author.uid == request.auth.uid;
    }
    
    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
